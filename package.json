{
  "name": "rn-a11y",
  "version": "0.1.0",
  "description": "Audit the accessibility of a running React Native app on iOS simulators and Android emulators or devices, against WCAG 2.2 and the platform guidelines.",
  "license": "MIT",
  "author": "Kushagra Sinha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kushagra21/rn-a11y.git"
  },
  "homepage": "https://github.com/kushagra21/rn-a11y#readme",
  "bugs": "https://github.com/kushagra21/rn-a11y/issues",
  "type": "module",
  "bin": {
    "rn-a11y": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "react-native",
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "voiceover",
    "talkback",
    "audit",
    "contrast",
    "touch-target",
    "simulator",
    "adb",
    "cli"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "picocolors": "^1.1.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
